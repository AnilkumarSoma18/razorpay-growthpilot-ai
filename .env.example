# ============================================================
# Razorpay GrowthPilot AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER use live Razorpay keys.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+psycopg2://growthpilot:growthpilot@localhost:5432/growthpilot
REDIS_URL=redis://localhost:6379/0

# --- Razorpay (TEST MODE ONLY — keys must start with rzp_test_) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# If true, /api/webhooks/razorpay/demo is enabled for deterministic local
# demos. Demo events are always labeled SIMULATED and are never treated as
# real Razorpay events.
DEMO_WEBHOOK_MODE=true

# --- LLM provider abstraction (default: gemini) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
# LLM_MODEL is provider-specific, e.g. gemini-2.0-flash / gpt-4o / claude-sonnet-4-6
LLM_MODEL=

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_value
JWT_EXPIRY_MINUTES=60

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- Money-safety policy limits ---
DISCOUNT_LIMIT_PERCENT=20
TRANSACTION_LIMIT_INR=100000
